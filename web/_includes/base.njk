<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}{% if title != site.title %} | {{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ summary or site.description }}">
    {% if entry %}
    <meta data-pagefind-meta="date[content]" content="{{ entry.processedAt }}">
    <meta data-pagefind-meta="category[content]" content="{{ entry.category }}">
    <meta data-pagefind-meta="type[content]" content="{{ entry.type }}">
    <meta data-pagefind-filter="category[content]" content="{{ entry.category }}">
    <meta data-pagefind-filter="type[content]" content="{{ entry.type }}">
    {% endif %}
    <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#101216" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/site.css">
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css">
    <script>
      try {
        var theme = localStorage.getItem("knowledge-theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch (error) {}
    </script>
    <pagefind-config
      bundle-path="{{ '/pagefind/' | htmlBaseUrl }}"
      base-url="{{ '/' | htmlBaseUrl }}"
      lang="en"
    ></pagefind-config>
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
    <script src="/assets/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "partials/header.njk" %}

    <div class="site-shell">
      {% include "partials/sidebar.njk" %}
      <main id="main" class="site-main" tabindex="-1">
        {% block content %}{{ content | safe }}{% endblock %}
      </main>
    </div>

    {% include "partials/footer.njk" %}

    <pagefind-modal reset-on-close>
      <pagefind-modal-header>
        <pagefind-input placeholder="Search the knowledge base…"></pagefind-input>
      </pagefind-modal-header>
      <pagefind-modal-body>
        <pagefind-summary default-message="Search titles, code, notes, and tables."></pagefind-summary>
        <pagefind-results></pagefind-results>
      </pagefind-modal-body>
      <pagefind-modal-footer>
        <pagefind-keyboard-hints></pagefind-keyboard-hints>
      </pagefind-modal-footer>
    </pagefind-modal>
  </body>
</html>
