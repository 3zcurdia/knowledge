<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <button class="icon-button menu-button" type="button" data-menu-toggle aria-label="Toggle navigation" aria-controls="sidebar" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>

    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">K</span>
      <span>{{ site.title }}</span>
    </a>

    <nav class="top-nav" aria-label="Primary">
      <a class="{% if page.url == '/browse.html' | htmlBaseUrl %}active{% endif %}" href="/browse.html">Browse</a>
      <a class="{% if page.url == '/search.html' | htmlBaseUrl %}active{% endif %}" href="/search.html">Search</a>
    </nav>

    <div class="header-actions">
      <pagefind-modal-trigger compact placeholder="Search" shortcut="mod+k"></pagefind-modal-trigger>
      <button class="icon-button theme-button" type="button" data-theme-toggle aria-label="Switch color theme">
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path></svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path></svg>
      </button>
    </div>
  </div>
</header>
